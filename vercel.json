{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"version": 2,
	"buildCommand": "npm run build",
	"outputDirectory": "public",
	"rewrites": [
		{
			"source": "/api/:path*",
			"destination": "/api/index"
		}
	],
	"headers": [
		{
			"source": "/:path*",
			"headers": [
				{
					"key": "Cross-Origin-Opener-Policy",
					"value": "same-origin"
				},
				{
					"key": "Cross-Origin-Embedder-Policy",
					"value": "require-corp"
				}
			]
		}
	]
}
