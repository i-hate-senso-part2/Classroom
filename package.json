{
	"name": "scramjet-demo",
	"version": "2.0.0",
	"description": "The demo application for Scramjet, a high-performance web proxy.",
	"type": "module",
	"engines": {
		"npm": ">=7.0.0",
		"node": ">=20.0.0"
	},
	"scripts": {
		"build": "node scripts/prepare-static-assets.js",
		"start": "npm run build && node src/index.js",
		"hash-admin-password": "node scripts/hash-admin-password.js",
		"format": "prettier --write .",
		"lint": "eslint ./src/",
		"lint:fix": "eslint ./src/ --fix"
	},
	"keywords": [
		"proxy"
	],
	"author": "why u lookin",
	"license": "GNU AFFERO",
	"dependencies": {
		"@fastify/static": "^9.0.0",
		"@mercuryworkshop/libcurl-transport": "^2.0.6",
		"@mercuryworkshop/scramjet": "https://github.com/MercuryWorkshop/scramjet/releases/download/v2.0.67-alpha.2/mercuryworkshop-scramjet-2.0.67-alpha.2.tgz",
		"@mercuryworkshop/scramjet-controller": "https://github.com/MercuryWorkshop/scramjet/releases/download/v2.0.67-alpha.2/mercuryworkshop-scramjet-controller-0.0.14.tgz",
		"@mercuryworkshop/wisp-js": "^0.4.1",
		"dotenv": "^18.0.10",
		"fastify": "^5.7.4",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"eslint": "^9.13.0",
		"prettier": "^3.3.3"
	},
	"packageManager": "pnpm@10.18.3"
